{
  "name": "Ubuntu Vinegar Studio",
  "friendly_name": "Ubuntu + Vinegar Studio",
  "description": "Ubuntu with Flatpak and Vinegar",
  "image": "kasmweb/ubuntu-jammy-desktop:1.14.0",

  "kasm_version": ">=1.18.0",

  "cores": 2,
  "memory": 4096,
  "disk": 8192,

  "categories": ["Desktop"],
  "architecture": ["amd64"],

  "exec_config": {
    "first_launch": {
      "cmd": [
        "/bin/bash",
        "-c",
        "sudo apt update && sudo apt install -y flatpak && flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo && flatpak install -y flathub org.vinegarhq.Vinegar"
      ]
    }
  },

  "launch_config": {
    "cmd": [
      "/bin/bash",
      "-c",
      "flatpak run org.vinegarhq.Vinegar studio"
    ]
  }
}
